{
  "name": "paseo-accounts",
  "version": "2.1.1",
  "description": "Paseo Accounts (formerly ZeroSub): add more accounts to any Paseo provider. Each account becomes its own provider (and profile), with in-app sign-in and usage for Claude and ChatGPT (Codex).",
  "keywords": [
    "zerosub",
    "paseo",
    "paseo-plugin",
    "claude",
    "claude-code",
    "codex",
    "chatgpt",
    "accounts",
    "providers",
    "profiles",
    "subscriptions"
  ],
  "homepage": "https://github.com/raffidahmad/paseo-accounts#readme",
  "bugs": {
    "url": "https://github.com/raffidahmad/paseo-accounts/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raffidahmad/paseo-accounts.git"
  },
  "license": "MIT",
  "author": "raffidahmad",
  "files": [
    "paseo-plugin.json",
    "index.client.tsx",
    "index.server.ts",
    "client/",
    "server/",
    "shared/",
    "!**/*.test.ts",
    "README.md",
    "OVERVIEW.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "audit:mobile": "! grep -rnE \"\\\\b(document|window|localStorage|navigator)\\\\.|<(div|span|p|a|button|input|img|ul|ol|li|section|header|footer|main|nav|form|label|h[1-6]|table|tr|td|svg|path|br|hr)[ >/]|className=|onClick=\" client/"
  },
  "devDependencies": {
    "@getpaseo/client": "0.9.1",
    "@getpaseo/plugin": "0.9.1",
    "@getpaseo/protocol": "0.9.1",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^22.20.4",
    "@types/react": "~19.2.0",
    "esbuild": "0.28.2",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "zod": "^4.4.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "contributors": [
    "Kapybara (original ZeroSub)"
  ]
}
